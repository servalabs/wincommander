{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "WinCommander",
    "version":  "3.2.3",
    "identifier":  "com.servalabs.wincommander",
    "build":  {
                  "beforeDevCommand":  "bun run setup:dev \u0026\u0026 bun run fetch-icons \u0026\u0026 bun run dev:server",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "bun install --frozen-lockfile \u0026\u0026 bun run encrypt-backend \u0026\u0026 bun x tsc \u0026\u0026 bun x vite build",
                  "frontendDist":  "../../dist"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "WinCommander",
                                    "width":  1200,
                                    "height":  800,
                                    "minWidth":  900,
                                    "minHeight":  600,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "decorations":  false,
                                    "transparent":  false,
                                    "center":  true,
                                    "visible":  false
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027 tauri: asset: ipc:; script-src \u0027self\u0027 tauri: asset: ipc:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027 tauri: asset:; img-src \u0027self\u0027 data: blob: tauri: asset: https:; font-src \u0027self\u0027 data: tauri: asset:; connect-src \u0027self\u0027 tauri: ipc: http://ipc.localhost http://tauri.localhost https://winupdates.servalabs.com https://wincommander-licensing.servalabs.com http://localhost:1420 ws://localhost:1420 http://[::1]:1420 ws://[::1]:1420 http://localhost:8787 ws://localhost:8787 http://127.0.0.1:8787 ws://127.0.0.1:8787 http://*.ts.net:* https://*.ts.net:* ws://*.ts.net:* wss://*.ts.net:*; frame-src \u0027self\u0027 tauri: asset: https:; media-src \u0027self\u0027 tauri: asset: data: blob:; object-src \u0027none\u0027; base-uri \u0027self\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  "all",
                   "publisher":  "Secure Health",
                   "homepage":  "https://servalabs.com",
                   "resources":  [
                                     "scripts/core/*.enc",
                                     "scripts/modules/**/*.enc"
                                 ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "licenseFile":  "nsis/LICENSE.rtf",
                   "windows":  {
                                   "certificateThumbprint":  null,
                                   "digestAlgorithm":  "sha256",
                                   "timestampUrl":  "",
                                   "nsis":  {
                                                "installMode":  "perMachine",
                                                "installerHooks":  "nsis/hooks.nsh"
                                            }
                               }
               },
    "plugins":  {
                    "shell":  {
                                  "open":  true
                              },
                    "updater":  {
                                    "active":  true,
                                    "endpoints":  [
                                                      "https://winupdates.servalabs.com/free/latest.json"
                                                  ],
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4ODY4MjkxOUU5QjJGNUEKUldSYUw1dWVrWUtHdUpyNURuLzFwQ2kwbDBzM0VmZUZtczIzU2EwNUpyaFFjMTRKOWVFUkMxRGkK"
                                }
                }
}