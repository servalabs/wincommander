# Agent scratch files + the bundled CLI binary (claude.exe is ~242MB — GitHub
# rejects >100MB, so an accidental `git add -A` push fails for everyone sharing
# this tree). Keep them untracked.
claude.exe
.tscout.txt
.lintout.txt
.anim-rules.txt
.kf-ref.txt
.bp-swap.mjs
.cyan-fix.mjs
mcps/
terminals/

# Dependencies
node_modules/
.pnp
.pnp.js
.npm-cache/

# Lockfiles — repo standardises on Bun (bun.lock); other lockfiles are
# left over from package-manager experimentation and must not be
# committed alongside Bun's lock to avoid drift.
package-lock.json
pnpm-lock.yaml

*.enc

# Per-build encryption salt (generated by encrypt.ts, consumed by build.rs)
.build_salt

# ts-rs codegen scratch — raw output of `cargo test --features ts-codegen`.
# The tracked SSOT copy lives in src/types/generated/ (written by tools/gen-types.ts).
# One entry per crate that derives ts_rs::TS — keep this list in sync with
# gen-types.ts's FILES table (A6 2026-08: added wincmd-clip-rules/fleet-proto,
# which were missing here even though gen-types.ts's own header comment and
# AGENTS.md both already described bindings/ as gitignored for every crate).
src-tauri/wincmd-shared/bindings/
src-tauri/fleet-proto/bindings/
src-tauri/wincmd-clip-rules/bindings/

