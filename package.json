{
  "name": "wincommander-free",
  "private": true,
  "version": "3.1.0",
  "license": "AGPL-3.0",
  "description": "WinCommander Free — open-source primary",
  "type": "module",
  "scripts": {
    "encrypt-backend": "bun run tools/encrypt.ts",
    "fetch-icons": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fetch-app-icons.ps1",
    "kill:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/kill-dev.ps1",
    "build:pro": "bun run tools/build-pro.ts",
    "build:pro:release": "bun run tools/build-pro.ts --release",
    "setup:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/ensure-dev-environment.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev.ps1 -ServerOnly",
    "dev:server": "bun run tools/dev-server.ts",
    "dev:free": "bun run setup:dev && bun run tools/dev-server.ts --free",
    "dev:tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev.ps1",
    "dev:tauri:free": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev.ps1",
    "dev:reset": "powershell -Command \"Remove-Item -Path $env:LOCALAPPDATA\\WinCommander\\store\\settings.dat -ErrorAction SilentlyContinue; Remove-Item -Path $env:LOCALAPPDATA\\WinCommander\\settings.json -ErrorAction SilentlyContinue; Remove-Item -Path $env:APPDATA\\WinCommander\\settings.json -ErrorAction SilentlyContinue\"; bun run dev:tauri",
    "dev:all": "bun run tools/dev-all.ts",
    "hash-pro": "bun run tools/hash-pro.ts",
    "build:free": "bun run encrypt-backend && bun x tsc && bun x vite build",
    "build": "bun run encrypt-backend && bun run build:pro:release && bun run hash-pro && bun x tsc && bun x vite build",
    "build:tauri:release": "bun run encrypt-backend && bun run build:pro:release && bun run hash-pro && bun x tsc && bun x vite build && bun x tauri build --config src-tauri/commander-free/tauri.conf.json",
    "build:fleet-kit": "bun run tools/make-fleet-kit.ts --release",
    "build:fleet-kit:debug": "bun run tools/make-fleet-kit.ts",
    "preview": "bun x vite preview",
    "tauri": "bun x tauri",
    "gen:types": "bun run tools/gen-types.ts",
    "gen:types:check": "bun run tools/gen-types.ts --check",
    "lint:tiers": "bun run tools/check-tier-invariants.ts && bun run tools/check-tier-drift.ts",
    "lint:strings-free": "powershell -ExecutionPolicy Bypass -File tools/strings-grep-free.ps1 -HardGate",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@fontsource/space-grotesk": "5.2.10",
    "@radix-ui/react-accordion": "1.2.15",
    "@radix-ui/react-alert-dialog": "1.1.18",
    "@radix-ui/react-checkbox": "1.3.6",
    "@radix-ui/react-collapsible": "1.1.15",
    "@radix-ui/react-dialog": "1.1.18",
    "@radix-ui/react-dropdown-menu": "2.1.19",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-popover": "1.1.18",
    "@radix-ui/react-progress": "1.1.11",
    "@radix-ui/react-scroll-area": "1.2.13",
    "@radix-ui/react-select": "2.3.2",
    "@radix-ui/react-separator": "1.1.11",
    "@radix-ui/react-slider": "1.4.2",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.2",
    "@radix-ui/react-tabs": "1.1.16",
    "@radix-ui/react-tooltip": "1.2.11",
    "@tanstack/react-query": "5.101.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@xyflow/react": "12.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "framer-motion": "12.42.2",
    "lucide-react": "1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.62.1",
    "@vitejs/plugin-react": "6.0.3",
    "esbuild": "0.28.1",
    "eslint": "10.6.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.3"
  }
}