{
  "name": "wincommander-free",
  "private": true,
  "version": "3.4.17",
  "license": "AGPL-3.0",
  "description": "WinCommander Free — open-source primary",
  "type": "module",
  "scripts": {
    "encrypt-backend": "bun run tools/encrypt.ts",
    "fetch-icons": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fetch-app-icons.ps1",
    "kill:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/kill-dev.ps1",
    "build:pro": "bun run tools/build-pro.ts",
    "build:pro:release": "bun run tools/build-pro.ts --release",
    "build:service:release": "cargo build --manifest-path src-tauri/Cargo.toml -p commander-svc --release",
    "setup:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/ensure-dev-environment.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev.ps1",
    "dev:server": "bun run tools/dev-server.ts",
    "dev:free": "bun run setup:dev && bun run tools/dev-server.ts --free",
    "dev:tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev.ps1",
    "dev:tauri:free": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev.ps1",
    "dev:reset": "powershell -Command \"Remove-Item -Path $env:ProgramData\\WinCommander\\store\\settings.dat -ErrorAction SilentlyContinue; Remove-Item -Path $env:LOCALAPPDATA\\WinCommander\\settings.json -ErrorAction SilentlyContinue; Remove-Item -Path $env:APPDATA\\WinCommander\\settings.json -ErrorAction SilentlyContinue\"; bun run dev:tauri",
    "dev:all": "bun run tools/dev-all.ts",
    "hash-pro": "bun run tools/hash-pro.ts",
    "build:free": "bun run encrypt-backend && bun x tsc && bun x vite build",
    "build": "bun run encrypt-backend && bun run build:service:release && bun run build:pro:release && bun run hash-pro && bun x tsc && bun x vite build",
    "build:tauri:release": "bun run gen:eula-rtf:check && bun run encrypt-backend && bun run build:pro:release && bun run hash-pro && bun x tsc && bun x vite build && bun run tools/build-tauri-release.ts",
    "build:free:release-installer": "bun run gen:eula-rtf:check && bun run tools/build-tauri-release.ts",
    "build:fleet-kit": "bun run tools/make-fleet-kit.ts --release",
    "build:fleet-kit:debug": "bun run tools/make-fleet-kit.ts",
    "preview": "bun x vite preview",
    "tauri": "bun x tauri",
    "gen:types": "bun run tools/gen-types.ts",
    "gen:types:check": "bun run tools/gen-types.ts --check",
    "gen:cli-catalog": "bun run tools/gen-cli-catalog.ts",
    "gen:cli-catalog:check": "bun run tools/gen-cli-catalog.ts --check",
    "gen:eula-rtf": "bun run tools/gen-eula-rtf.ts",
    "gen:eula-rtf:check": "bun run tools/gen-eula-rtf.ts --check",
    "lint:tiers": "bun run tools/check-tier-invariants.ts && bun run tools/check-tier-drift.ts",
    "lint:quality": "bun run tools/check-code-quality-guards.ts",
    "lint:strings-free": "powershell -ExecutionPolicy Bypass -File tools/strings-grep-free.ps1 -HardGate",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "startup:benchmark": "bun tools/startup-benchmark.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.102.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.5",
    "@tauri-apps/plugin-updater": "2.10.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "framer-motion": "13.1.1",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "6.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
