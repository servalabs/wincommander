# ============================================================
# WinCommander — Environment Variables
# Copy this file to .env and fill in your own values.
# .env is gitignored and must NEVER be committed.
# ============================================================

# ------------------------------------------------------------
# Tauri Updater Signing (minisign keypair)
# Generate with: bun x tauri signer generate -w .env
# The private key is base64-encoded minisign encrypted secret key.
# The public key goes here AND into src-tauri/tauri.conf.json → bundle.updater.pubkey
# ------------------------------------------------------------
TAURI_SIGNING_PRIVATE_KEY=<base64-encoded-minisign-private-key>
TAURI_SIGNING_PUBLIC_KEY=<base64-encoded-minisign-public-key>
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=<password-for-private-key>

# ------------------------------------------------------------
# Cloudflare R2 (update artifact storage)
# Create an R2 bucket and API token at dash.cloudflare.com
# Token needs: Object Read & Write on your bucket
# ------------------------------------------------------------
CF_ACCOUNT_ID=<cloudflare-account-id>
CF_R2_API=https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
CF_UPDATE_DOMAIN=<your-r2-public-domain>   # e.g. updates.yourdomain.com
R2_TOKEN=<r2-api-token>
R2_KEY=<r2-access-key-id>
R2_SECRET=<r2-secret-access-key>

# ------------------------------------------------------------
# License Worker (Cloudflare Worker + D1)
# Deploy cloudflare-license-worker/ and set these to point at it.
# WINCMD_LICENSE_PUBLIC_KEY must match the private key set as a
# wrangler secret on the worker (LICENSE_PRIVATE_KEY_B64).
# ------------------------------------------------------------
WINCMD_LICENSE_API_BASE=https://your-worker.your-subdomain.workers.dev
WINCMD_LICENSE_PUBLIC_KEY=<ed25519-public-key-base64>

# ------------------------------------------------------------
# International Payment Link (non-India customers)
# Stripe Payment Link / Lemon Squeezy / Paddle URL — opens in an
# external browser when the in-app license dialog detects a non-IN
# country via the worker's /whoami endpoint. Customers in India
# see the UPI QR instead of this link. Empty string falls back to
# a mailto:winsales@servalabs.com "contact us" prompt.
# Vite injects this into the bundle at build time (must be VITE_*-prefixed).
# ------------------------------------------------------------
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-payment-link

# ------------------------------------------------------------
# Dev-only entitlement overrides (debug builds ONLY — release builds
# compile these out via #[cfg(debug_assertions)] and ignore them
# entirely). Both default off; set to "1" to opt in.
#
# WINCMD_DEV_ADVANCED=1
#   Injects "advanced" into the licence features array as soon
#   as `bun run tauri dev` boots. The Investigator panel + sidebar
#   entry appear; the amber INVESTIGATOR MODE banner shows on the
#   Cleanup panel; the dispatch layer starts refusing
#   Clear- / Erase- / Remove- / Reset- commands and refuses the Pro
#   sidecar for destructive verbs.
#
# WINCMD_DEV_PRO=1
#   Injects "paid" so every Pro feature unlocks without a real
#   licence. Useful for testing Pro panels (Mesh VPN, Encrypted
#   Volumes, etc.) without going through the Cloudflare worker
#   activation flow.
#
# Both can be set simultaneously to test combinations. Release MSI
# builds will not read these — only a real Ed25519-signed JWT with
# the right features activates these gates in production.
# ------------------------------------------------------------
# WINCMD_DEV_ADVANCED=1
# WINCMD_DEV_PRO=1

# ------------------------------------------------------------
# Fleet dev server persistence (optional).
# `bun run dev:all` (tools/dev-all.ts) spawns fleet-server with
# `...process.env`, so setting these here makes it use a real
# Postgres database instead of the default in-memory store (which
# loses all enrolled devices on every restart).
#
# DATABASE_URL requires a local Postgres role/db, e.g.:
#   createuser fleet --pwprompt && createdb fleet -O fleet
# FLEET_CHECKIN_KEK is mandatory once DATABASE_URL is set (fleet-server
# refuses to start without it in "production mode") — generate with:
#   openssl rand -hex 32
# ------------------------------------------------------------
# DATABASE_URL=postgres://fleet:<password>@127.0.0.1:5432/fleet
# FLEET_CHECKIN_KEK=<64-hex-char-random-key>
